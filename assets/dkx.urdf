  <!-- Right wrist camera: ZED X One S, fisheye. right_wrist_camera_link = housing (bottom-face centre, x = optical axis, z up);
       right_wrist_camera_frame = CMOS image-plane centre, x forward (REP-103 body); right_wrist_camera_optical_frame = same point,
       z along the optical axis, x right, y down (what intrinsics/projection refer to);
       right_wrist_camera_fov_vertex = the CAD's FOV cone vertex, 16.48 mm ahead of the image plane. -->
  <link name="right_wrist_camera_link">
